<Window x:Class="ResolutionMatcher.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResolutionMatcher Settings"
        Height="280"
        Width="320"
        ResizeMode="NoResize">
  <StackPanel Margin="20">

    <TextBlock Text="Aspect Ratio"
               Margin="0,0,0,4"/>
    <ComboBox x:Name="AspectRatioComboBox"
              Width="200"
              HorizontalAlignment="Left"
              Margin="0,0,0,12"
              SelectionChanged="OnAspectRatioChanged"/>

    <TextBlock Text="Target Resolution"
               Margin="0,0,0,4"/>
    <ComboBox x:Name="ResolutionComboBox"
              Width="200"
              HorizontalAlignment="Left"
              Margin="0,0,0,12"/>

    <TextBlock Text="Process Name"
               Margin="0,0,0,4"/>
    <TextBox x:Name="ProcessNameTextBox"
             Width="200"
             HorizontalAlignment="Left"
             Margin="0,0,0,20"/>

    <Button Content="Save"
            Width="80"
            HorizontalAlignment="Left"
            Click="OnSaveClicked"/>

  </StackPanel>
</Window>