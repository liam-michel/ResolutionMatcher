<Window x:Class="ResolutionMatcher.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResolutionMatcher Settings" Height="220" Width="320"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        
        <TextBlock Text="Target Resolution" Margin="0,0,0,4"/>
        <ComboBox x:Name="ResolutionComboBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
            <ComboBoxItem Content="1280x960"/>
            <ComboBoxItem Content="1280x1024"/>
            <ComboBoxItem Content="1400x1050"/>
            <ComboBoxItem Content="1600x1200"/>
        </ComboBox>

        <TextBlock Text="Process Name" Margin="0,0,0,4"/>
        <TextBox x:Name="ProcessNameTextBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20"/>

        <Button Content="Save" Width="80" HorizontalAlignment="Left" Click="OnSaveClicked"/>
        
    </StackPanel>
</Window>